# P0 runs without provider credentials. Blank = unavailable, never connected.
APP_URL=http://localhost:3000
# Required when owner authentication/database access arrives in P2.
AUTH_SECRET=
MONGODB_URI=
MONGODB_DB=
# Required for real extraction in P3; use an endpoint actually serving Gemma.
GEMMA_API_BASE_URL=
GEMMA_MODEL_ID=
GEMMA_API_KEY=
# Required for email delivery in P4 (verified sender and owner recipient).
EMAIL_API_KEY=
EMAIL_FROM=
# Optional telemetry in P6.
SENTRY_DSN=

# Optional server tracing rate: 0 disables spans, 1 captures every trace.
# Default 0.1; use 1 only for a bounded synthetic evidence run.
SENTRY_TRACES_SAMPLE_RATE=
