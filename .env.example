# P0 runs without provider credentials. Blank = unavailable, never connected.
APP_URL=http://localhost:3000
# Required when owner authentication/database access arrives in P2.
AUTH_SECRET=
MONGODB_URI=
MONGODB_DB=
# Required for real extraction in P3; use an endpoint actually serving Gemma.
# Any OpenAI-compatible /chat/completions base URL (e.g. Google AI Studio's
# https://generativelanguage.googleapis.com/v1beta/openai, vLLM, Ollama /v1).
# GEMMA_MODEL_ID must start with "gemma-" (verified: gemma-4-26b-a4b-it).
GEMMA_API_BASE_URL=
GEMMA_MODEL_ID=
GEMMA_API_KEY=
# P4 Resend adapter. Secret key and verified sender; blank = non-delivering preview only.
# EMAIL_FROM may be a bare sender address or KAI247 <sender@example.com>.
# Recipient is never configured here: only the authenticated owner's verified email.
EMAIL_API_KEY=
EMAIL_FROM=
# Optional telemetry in P6.
SENTRY_DSN=
# Explicit operator-only provisioning. Never put a real password in this sample.
# synthetic requires an example.invalid address; private is an isolated real owner.
SEED_OWNER_MODE=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_WORKSPACE_NAME=
