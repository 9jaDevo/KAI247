{
  "name": "kai247-renewpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:local": "node scripts/db-local.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "owner:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-owner.mjs",
    "format": "prettier --write src scripts tests package.json tsconfig.json *.mjs",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json *.mjs",
    "reminders:process": "node scripts/process-reminders.mjs",
    "ai:proof": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/gemma-live-proof.ts",
    "fixtures:p3": "node scripts/generate-p3-fixtures.mjs",
    "start:render": "node scripts/start-production.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@next/env": "16.4.0",
    "@sentry/nextjs": "11.8.0",
    "iron-session": "9.0.1",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "mongodb-memory-server-core": "11.3.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
